# ─────────────────────────────────────────────────────────────
# TARS environment — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# --- Provider API keys (only the one(s) you are running need to be set) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# --- Default model per provider (overridable per-agent in config) ---
# Claude defaults to Opus 4.8 (strongest reasoning for security analysis).
# Tune per-agent for cost: e.g. claude-haiku-4-5 for cheap agents, Opus for the reviewer.
CLAUDE_MODEL=claude-opus-4-8
GROK_MODEL=grok-4
SOL_MODEL=gpt-5

# --- Azure read-only service principal (Reader + Security Reader) ---
# The scanner authenticates as this SP. It must be READ-ONLY.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# --- Runtime ---
# offline = run against recorded fixtures with a canned LLM response (no keys needed)
# live    = call the real LLM (and Azure when LiveAzureConnector is wired)
TARS_MODE=offline
TARS_RUN_DIR=./runs

# --- Bake-off ---
# Comma-separated providers to enter: claude, grok, sol (default: all three)
# BAKEOFF_PROVIDERS=claude,grok,sol
# Live bake-off uses Claude as the blinded reportQuality judge when TARS_MODE=live.
